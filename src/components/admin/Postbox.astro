---
import Icon from './Icon.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<section class="pb">
  <div class="pb__head">
    <h2>{title}</h2>
    <div class="pb__ctrl">
      <button type="button" aria-label="Subir caja"><Icon name="chevronUp" size={16} /></button>
      <button type="button" aria-label="Bajar caja"><Icon name="chevronDown" size={16} /></button>
    </div>
  </div>
  <div class="pb__body"><slot /></div>
</section>
