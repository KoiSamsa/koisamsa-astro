---
import Icon from './Icon.astro';
import { brand, keystatic } from '../../data/admin';
---
<header class="ab">
  <div class="ab__group">
    <a href="/admin/" class="ab__item ab__logo" aria-label={`Acerca de ${brand.name}`}><span class="monogram">{brand.initial}</span></a>
    <a href="/" class="ab__item"><Icon name="home" size={18} /><span>{brand.site}</span></a>
    <a href="/admin/" class="ab__item" aria-label="1 comentario pendiente de moderación"><Icon name="comments" size={18} /><span>1</span></a>
    <a href={keystatic.create} class="ab__item"><Icon name="plus" size={18} /><span>Nuevo</span></a>
  </div>
  <a href="/admin/" class="ab__item">Hola, <strong>admin</strong><span class="ab__avatar">A</span></a>
</header>
